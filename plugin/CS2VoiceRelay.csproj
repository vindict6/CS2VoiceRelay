<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CS2VoiceRelay</AssemblyName>
    <RootNamespace>CS2VoiceRelay</RootNamespace>
    <!-- CounterStrikeSharp ships its own copies of its dependencies; don't bundle them with the plugin -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
  </ItemGroup>
</Project>
