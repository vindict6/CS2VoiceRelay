<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CS2VoiceRelay</AssemblyName>
    <RootNamespace>CS2VoiceRelay</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against CounterStrikeSharp only: the server already provides it and its dependencies,
         and a second copy in the plugin folder breaks type identity at load time. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The browser player is served straight from the plugin DLL -->
    <EmbeddedResource Include="web\index.html" />
    <EmbeddedResource Include="web\app.js" />
    <EmbeddedResource Include="web\voice-engine.js" />
    <EmbeddedResource Include="web\opus-decoder.min.js" />
    <EmbeddedResource Include="web\widget.js" />
    <!-- !testvoice chime: 20 ms Opus frames, [u16 length][frame] each -->
    <EmbeddedResource Include="sounds\test-chime.bin" />
  </ItemGroup>
</Project>
